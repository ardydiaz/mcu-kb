PORT=4001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mcu_knowledge_base

# Local semantic retrieval and grounded answers
QDRANT_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mcu_knowledge_chunks
QDRANT_SCORE_THRESHOLD=0.42
QDRANT_FALLBACK_TO_MYSQL=true

OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_ANSWER_TOKENS=180
OLLAMA_MAX_EXCERPT_CHARS=1600
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_KEEP_ALIVE=30m

# Optional AI configuration. Without these values, content search still returns
# the most relevant extracted passages and citations.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional OCR fallback for scanned PDFs.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
